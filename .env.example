# ─────────────────────────────────────────────────────────────
# 123RUIT | Autoglas Amersfoort — omgevingsvariabelen
# Kopieer naar .env.local (lokaal) of stel in via Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Definitieve domeinnaam (zonder slash aan het eind). Gebruikt voor canonical, sitemap, Open Graph en JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.jouwdomein.nl

# WhatsApp-nummer in internationaal formaat, alleen cijfers (bijv. 31612345678).
# Laat leeg zolang het nummer niet is bevestigd: alle WhatsApp-knoppen blijven dan verborgen.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optioneel: directe link naar het geverifieerde Google Bedrijfsprofiel (reviews-sectie).
# Leeg = er wordt een Google Maps-zoeklink op bedrijfsnaam + adres gebruikt.
NEXT_PUBLIC_GOOGLE_PROFILE_URL=

# ── E-mail via Resend (https://resend.com) — alleen server-side, nooit NEXT_PUBLIC_ ──
RESEND_API_KEY=
# Afzender: moet een in Resend geverifieerd domein gebruiken.
MAIL_FROM="Website Autoglas Amersfoort <aanvraag@jouwdomein.nl>"
# Ontvanger van schadeaanvragen.
MAIL_TO=autoglasamersfoort@123ruit.nl
